+    null,
+  );
+  assert.equal(
+    sanitizeLifecycleDetail(
+      Object.defineProperty({}, "broken", {
+        enumerable: true,
+        get() {
+          throw new Error("getter must stay inside the diagnostic boundary");
+        },
+      }),
+    ),
+    null,
+  );
+  assert.deepEqual(
+    sanitizeDiagnosticLifecycleInput(
+      "dplayer-quality-switch-start",
