diff --git a/tests/test_responses.py b/tests/test_responses.py
index fa20795d51dc8ab9bf4e28e44aeb85e77e0b1316..a66dc14a47fe0a366fabdedd3aecb4834f97796d 100644
--- a/tests/test_responses.py
+++ b/tests/test_responses.py
@@ -395,6 +395,118 @@ async def test_file_response_with_pathsend(tmpdir: Path) -> None:
     )
 
 
+@pytest.mark.anyio
+@pytest.mark.parametrize("spec_version", ["2.0", "2.3"])
+@pytest.mark.parametrize("range_header", [None, b"bytes=0-", b"bytes=0-262143,327680-524287"])
+async def test_file_response_stops_on_disconnect(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, spec_version: str, range_header: bytes | None
+) -> None:
+    path = tmp_path / "fixture.bin"
+    path.write_bytes(b"x" * (8 * FileResponse.chunk_size))
+    disconnected = anyio.Event()
+    file_closed = anyio.Event()
+    submitted = 0
+    background_ran = False
+    open_file = anyio.open_file
+
+    class TrackedFile:
+        def __init__(self, file: anyio.AsyncFile[bytes]) -> None:
+            self.file = file
+
+        async def read(self, size: int) -> bytes:
+            return await self.file.read(size)
+
+        async def seek(self, offset: int) -> int:
+            return await self.file.seek(offset)
+
+        async def aclose(self) -> None:
+            await anyio.sleep(0)
+            await self.file.aclose()
+            file_closed.set()
+
+    async def tracked_open_file(*args: Any, **kwargs: Any) -> TrackedFile:
+        return TrackedFile(await open_file(*args, **kwargs))
+
+    monkeypatch.setattr(anyio, "open_file", tracked_open_file)
+
+    async def receive() -> Message:
+        await disconnected.wait()
+        return {"type": "http.disconnect"}
+
+    async def send(message: Message) -> None:
+        nonlocal submitted
+        if message["type"] == "http.response.body":
+            submitted += len(message.get("body", b""))
+            if submitted >= FileResponse.chunk_size:
+                disconnected.set()
+
+    async def cleanup() -> None:
+        nonlocal background_ran
+        assert file_closed.is_set()
+        background_ran = True
+        path.unlink()
+
+    response = FileResponse(path, background=BackgroundTask(cleanup))
+    headers = [] if range_header is None else [(b"range", range_header)]
+    with anyio.fail_after(1):
+        await response(
+            {"type": "http", "method": "GET", "headers": headers, "asgi": {"spec_version": spec_version}},
+            receive,
+            send,
+        )
+    assert file_closed.is_set()
+    assert submitted < 4 * FileResponse.chunk_size, (
+        "Disconnect must stop the response before reading the remaining ranges."
+    )
+    assert background_ran
+    assert not path.exists()
+
+
+@pytest.mark.anyio
