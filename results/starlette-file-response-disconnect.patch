+            raise OSError("Disconnected")
+
+    response = FileResponse(path)
+    with pytest.raises(OSError, match="Disconnected"):
+        await response(
+            {"type": "http", "method": "GET", "headers": [], "asgi": {"spec_version": "2.4"}},
+            receive,
+            send,
+        )
+    assert submitted == FileResponse.chunk_size
